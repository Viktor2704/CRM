{
  "name": "novinzhstroy-backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "vitest run --reporter=verbose",
    "test:coverage": "vitest run --coverage",
    "test:legacy": "node --import tsx --test tests/*.test.ts",
    "start": "node dist/src/server.js",
    "migrate": "tsx scripts/migrate.ts",
    "verify:rbac": "node dist/scripts/rbac-regression.js",
    "verify:rbac:build": "npm run build && npm run verify:rbac"
  },
  "dependencies": {
    "@react-email/components": "^1.0.9",
    "@react-email/render": "^2.0.4",
    "@types/js-yaml": "^4.0.9",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "argon2": "^0.43.0",
    "bottleneck": "^2.19.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "https-proxy-agent": "^7.0.6",
    "js-yaml": "^4.1.1",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.11.0",
    "nodemailer": "^6.10.1",
    "pdf-parse": "^2.4.5",
    "pdfmake": "^0.3.6",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "react": "^19.2.4",
    "socket.io": "^4.8.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "undici": "^7.22.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^4.1.0",
    "supertest": "^7.2.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^4.1.0"
  }
}
